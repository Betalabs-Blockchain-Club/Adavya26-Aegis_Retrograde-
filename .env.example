# ---------------------------------------------------------------------------
# Operation Aegis Retrograde — server-side answers
# ---------------------------------------------------------------------------
# These values are read ONLY by the API routes in app/api/*. They are never
# NEXT_PUBLIC_, so Next.js will not inline them into the client bundle. Change
# them here to re-key every puzzle without touching a component.
# ---------------------------------------------------------------------------

# Stage 1 — THE ZOLA CIPHER: HASH-4 of the target stone
STAGE1_ANSWER=

# Stage 2 — THE COSMIC SALT: HASH-4 of the domain
STAGE2_ANSWER=

# Stage 3 — PROOF OF WORK: the winning nonce n for SHA-256(secret_key + n)
STAGE3_NONCE=
